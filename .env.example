DATABASE_URL="file:./dev.db"

# Backend API Security Key
# Set this to protect your /api/* endpoints. If empty or unset, endpoints remain open for local dev.
API_KEY="your-secret-api-key"

# Frontend API Configuration
# Client-side API key passed in headers ('x-api-key' and 'Authorization: Bearer <key>')
NEXT_PUBLIC_API_KEY="your-secret-api-key"

# Remote Backend URL (leave empty when running frontend and backend together on the same domain)
NEXT_PUBLIC_API_URL=""
